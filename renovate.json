{
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    "group:allNonMajor",
    "schedule:earlyMondays",
    ":automergeMinor",
    ":automergeTesters",
    ":automergeLinters",
    ":automergeTypes",
    ":automergePatch"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["mermaid", "/^@mermaid-js//"],
      "groupName": "Mermaid packages",
      "schedule": ["at any time"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "dependencyDashboard": {
    "enabled": true,
    "autoclose": true
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "rangeStrategy": "bump"
}

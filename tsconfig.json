{
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "static/**/*.js",
    "static/**/*.json",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": ["$app/types", "vitest/importMeta", "@playwright/test"]
  },
  "extends": "$app/tsconfig"
}

{
  "name": "mermaid-live-editor",
  "version": "2.0.67",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build:embed && vite dev",
    "dev:force": "MERMAID_LOCAL=true pnpm dev --force",
    "dev:test": "pnpm dev",
    "build": "pnpm build:embed && vite build",
    "build:embed": "vite build --config vite.embed.config.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --cache . && eslint .",
    "lint:fix": "prettier --write --cache . && eslint --fix .",
    "format": "prettier --write --cache .",
    "pre-commit": "lint-staged",
    "postinstall": "husky install && svelte-kit sync && (git config blame.ignoreRevsFile .git-blame-ignore-revs || true)",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/material-symbols": "^1.2.98",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "bits-ui": "^2.21.0",
    "c8": "12.0.0",
    "chai": "^6.3.0",
    "clsx": "^2.1.1",
    "cssnano": "^9.9.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es": "^4.1.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "lucide-svelte": "^1.0.1",
    "node-html-parser": "^9.0.7",
    "paneforge": "1.0.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.8",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.1.0",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fsegurai/codemirror-theme-vscode-dark": "^6.3.0",
    "@fsegurai/codemirror-theme-vscode-light": "^6.3.0",
    "@mermaid-js/examples": "^2.1.0",
    "@mermaid-js/layout-tidy-tree": "^1.0.1",
    "@mermaid-js/mermaid-zenuml": "^1.0.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "hammerjs": "^2.0.8",
    "js-base64": "3.9.6",
    "lodash-es": "^4.18.1",
    "mermaid": "^12.3.0",
    "mode-watcher": "^1.1.0",
    "monaco-editor": "0.57.0",
    "pako": "3.0.3",
    "plausible-tracker": "^0.3.9",
    "random-word-slugs": "0.1.7",
    "svg-pan-zoom": "3.6.2",
    "svg2roughjs": "^3.2.3",
    "uuid": "14.0.3"
  },
  "lint-staged": {
    "*.{ts,svelte,js,css,md,json}": [
      "prettier --plugin-search-dir=. --write",
      "eslint "
    ]
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
